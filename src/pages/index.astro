---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import { groupByMonth } from '../utils/archive';
import { makeExcerpt } from '../utils/excerpt';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const archive = groupByMonth(posts);
---
<Base title="Blog">
  <Fragment slot="sidebar">
    <Sidebar archive={archive} />
  </Fragment>

  {archive.map((group) => (
    <section id={group.key} class="archive-group">
      <h2 class="archive-group__label">{group.label}</h2>
      <ul class="post-list">
        {group.posts.map((post) => (
          <li class="post-card">
            <a href={`/blog/${post.id}/`}>
              <h3>{post.data.title}</h3>
            </a>
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
            </time>
            <p class="post-card__excerpt">{post.data.excerpt ?? makeExcerpt(post.body ?? '')}</p>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
