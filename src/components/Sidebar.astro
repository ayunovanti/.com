---
import type { ArchiveGroup } from '../utils/archive';
import AdSlot from './AdSlot.astro';

interface Props {
  archive: ArchiveGroup[];
}
const { archive } = Astro.props;
---
<aside class="sidebar" aria-label="Archive">
  <h2 class="sidebar__title">Archive</h2>
  <ul class="archive-list">
    {archive.map((group) => (
      <li>
        <a href={`/archive#${group.key}`}>{group.label}</a>
        <span class="count">{group.posts.length}</span>
      </li>
    ))}
  </ul>
  <AdSlot slot="1111111111" label="Sidebar ad" />
</aside>
