---
interface Comment {
  author: string;
  date: Date;
  content: string;
}
interface Props {
  comments?: Comment[];
}
const { comments = [] } = Astro.props;
---
{comments.length > 0 && (
  <section class="archived-comments" aria-label="Archived comments">
    <h2 class="archived-comments__title">Comments ({comments.length})</h2>
    <ul>
      {comments.map((c) => (
        <li class="archived-comment">
          <strong>{c.author}</strong>
          <time datetime={c.date.toISOString()}>{c.date.toDateString()}</time>
          <p>{c.content}</p>
        </li>
      ))}
    </ul>
  </section>
)}

<section class="giscus-comments" aria-label="Leave a comment">
  <h2 class="archived-comments__title">Leave a comment</h2>
  <script
    src="https://giscus.app/client.js"
    data-repo="ayunovanti/.com"
    data-repo-id="R_kgDOVUnUcQ"
    data-category="Comments"
    data-category-id="DIC_kwDOVUnUcc4DJaRM"
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="bottom"
    data-theme="light"
    data-lang="en"
    crossorigin="anonymous"
    async
  ></script>
</section>
