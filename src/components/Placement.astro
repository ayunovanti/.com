---
interface Props {
  slot: string;
  label?: string;
}
const { slot, label = 'Advertisement' } = Astro.props;
---
<div class="placement-slot">
  <span class="placement-slot__label">{label}</span>
  <ins
    class="adsbygoogle"
    style="display:block"
    data-ad-client="ca-pub-0014023689630737"
    data-ad-slot={slot}
    data-ad-format="auto"
    data-full-width-responsive="true"></ins>
  <script is:inline>
    (adsbygoogle = window.adsbygoogle || []).push({});
  </script>
</div>
